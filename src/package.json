{
  "name": "githud",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "preapp": "bash scripts/check-rust.sh && bash scripts/check-sandbox.sh",
    "app": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri dev",
    "preapp:build": "bash scripts/check-rust.sh && bash scripts/check-sandbox.sh",
    "app:build": "WEBKIT_DISABLE_DMABUF_RENDERER=1 tauri build",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@uiw/react-color-sketch": "^2.10.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  },
  "description": "GIT HUD — desktop replacement for the terminal workflow in AI-assisted development"
}
